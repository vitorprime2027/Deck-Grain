@model IEnumerable<DeckGrain.Models.Usuario>

<h1>Lista de Usuários</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Usuário</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>UsuarioId</th>
            <th>E-mail</th>
            <th>Status</th>
            <th>Data de Criação</th>
            <th>Perfil Vinculado</th>
            <th>Modo Noturno</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UsuarioId</td>
                <td>@item.Email</td>
                <td>@item.Status</td>
                <td>@item.DataCriacao.ToString("dd/MM/yyyy")</td>
                <td>@(item.Perfil?.Nome ?? "Sem perfil")</td>
                <td>@(item.Configuracao?.ModoNoturno == true ? "Ativado" : "Desativado")</td>
            </tr>
        }
    </tbody>
</table>
