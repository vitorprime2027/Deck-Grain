@model DeckGrain.Models.Perfil

<h1>Criar Novo Perfil</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome de Exibição</label>
        <input asp-for="Nome" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Biografia" class="form-label">Biografia</label>
        <textarea asp-for="Biografia" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="LinguagemPreferida" class="form-label">Linguagem Preferida</label>
        <input asp-for="LinguagemPreferida" class="form-control" placeholder="Ex: C#, Python, HTML" />
    </div>

    <div class="mb-3">
        <label asp-for="UsuarioId" class="form-label">Conta de Usuário (E-mail)</label>
        <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.Usuarios" required>
            <option value="">-- Selecione um Usuário --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Salvar Perfil</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>
