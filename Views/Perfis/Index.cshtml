@model IEnumerable<DeckGrain.Models.Perfil>

<h1>Lista de Perfis</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Perfil</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>PerfilId</th>
            <th>Nome</th>
            <th>Biografia</th>
            <th>Linguagem Preferida</th>
            <th>E-mail do Usuário</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PerfilId</td>
                <td>@item.Nome</td>
                <td>@item.Biografia</td>
                <td>@item.LinguagemPreferida</td>
                <td>@item.Usuario?.Email</td>
            </tr>
        }
    </tbody>
</table>
