@model DeckGrain.Models.Cadastro
@{
    ViewData["Title"] = "Cadastro";
}

<style>
    body {
        background-color: #DAC8B3;
        color: #3E2F20;
    }

    .card {
        background-color: #EFE6DB; /* Tom mais claro derivado do #DAC8B3 para dar contraste ao formulário */
        border: 2px solid #B08E6B;
    }

    .card-title {
        color: #7A5C3E;
        font-weight: 600;
    }

    .form-control {
        border-color: #B08E6B;
        background-color: #FAF6F1;
    }

        .form-control:focus {
            border-color: #8C6D4F;
            box-shadow: 0 0 0 0.25rem rgba(176, 142, 107, 0.35);
        }

    .painel-senha {
        background-color: #E6D8C8 !important;
        border-color: #B08E6B !important;
    }

    .btn-custom {
        background-color: #B08E6B;
        border-color: #B08E6B;
        color: #FFFFFF;
        font-weight: 500;
    }

        .btn-custom:hover:not(:disabled) {
            background-color: #967656;
            border-color: #967656;
            color: #FFFFFF;
        }

        .btn-custom:disabled {
            background-color: #C7B29B;
            border-color: #C7B29B;
            color: #FFFFFF;
        }

    .link-custom {
        color: #8C6D4F;
        font-weight: 600;
        text-decoration: none;
    }

        .link-custom:hover {
            color: #6B5036;
            text-decoration: underline;
        }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4">Criar Conta</h3>

                    <form asp-controller="Auth" asp-action="Cadastro" method="post" id="formCadastro">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- Nome Completo -->
                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">Nome Completo</label>
                            <input asp-for="Nome" class="form-control" placeholder="Ex: João Silva" required />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <!-- Nome de Usuário -->
                        <div class="mb-3">
                            <label asp-for="NomeUsuario" class="form-label">Nome de Usuário</label>
                            <input asp-for="NomeUsuario" class="form-control" placeholder="Ex: joaosilva" required />
                            <span asp-validation-for="NomeUsuario" class="text-danger small"></span>
                        </div>

                        <!-- E-mail -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-mail</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="seu@email.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Senha -->
                        <div class="mb-3">
                            <label asp-for="Senha" class="form-label">Senha</label>
                            <input asp-for="Senha" type="password" class="form-control" id="inputSenha" placeholder="Digite sua senha" required />
                            <span asp-validation-for="Senha" class="text-danger small"></span>

                            <!-- Painel de Validação em Tempo Real -->
                            <div class="mt-2 p-2 rounded border painel-senha">
                                <small class="text-muted d-block mb-1 fw-bold">A senha deve conter:</small>
                                <ul class="list-unstyled mb-0 small" id="requisitosSenha">
                                    <li id="req-tamanho" class="text-danger">
                                        <span class="icone">✖</span> Pelo menos 8 caracteres
                                    </li>
                                    <li id="req-letra" class="text-danger">
                                        <span class="icone">✖</span> Pelo menos uma letra (a-z, A-Z)
                                    </li>
                                    <li id="req-numero" class="text-danger">
                                        <span class="icone">✖</span> Pelo menos um número (0-9)
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Botão Cadastrar -->
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-custom" id="btnCadastrar" disabled>
                                Cadastrar
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <small>Já tem uma conta? <a asp-controller="Auth" asp-action="Login" class="link-custom">Fazer login</a></small>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const inputSenha = document.getElementById("inputSenha");
            const btnCadastrar = document.getElementById("btnCadastrar");

            const reqTamanho = document.getElementById("req-tamanho");
            const reqLetra = document.getElementById("req-letra");
            const reqNumero = document.getElementById("req-numero");

            function atualizarStatus(elemento, valido) {
                const icone = elemento.querySelector(".icone");
                if (valido) {
                    elemento.classList.remove("text-danger");
                    elemento.classList.add("text-success");
                    icone.textContent = "✔";
                } else {
                    elemento.classList.remove("text-success");
                    elemento.classList.add("text-danger");
                    icone.textContent = "✖";
                }
            }

            inputSenha.addEventListener("input", function() {
                const valor = inputSenha.value;

                const temTamanhoMinimo = valor.length >= 8;
                const temLetra = /[a-zA-Z]/.test(valor);
                const temNumero = /[0-9]/.test(valor);

                atualizarStatus(reqTamanho, temTamanhoMinimo);
                atualizarStatus(reqLetra, temLetra);
                atualizarStatus(reqNumero, temNumero);

                btnCadastrar.disabled = !(temTamanhoMinimo && temLetra && temNumero);
            });
        });
    </script>
}
