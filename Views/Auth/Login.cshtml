@model DeckGrain.Models.Login
@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background-color: #DAC8B3;
        color: #3E2F20;
    }

    .card {
        background-color: #EFE6DB;
        border: 2px solid #B08E6B;
    }

    .card-title {
        color: #7A5C3E;
        font-weight: 600;
    }

    .form-control {
        border-color: #B08E6B;
        background-color: #FAF6F1;
    }

        .form-control:focus {
            border-color: #8C6D4F;
            box-shadow: 0 0 0 0.25rem rgba(176, 142, 107, 0.35);
        }

    .form-check-input {
        border-color: #B08E6B;
        background-color: #FAF6F1;
    }

        .form-check-input:checked {
            background-color: #B08E6B;
            border-color: #B08E6B;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(176, 142, 107, 0.35);
        }

    .btn-toggle-custom {
        border-color: #B08E6B;
        color: #7A5C3E;
        background-color: #E6D8C8;
    }

        .btn-toggle-custom:hover {
            background-color: #B08E6B;
            border-color: #B08E6B;
            color: #FFFFFF;
        }

    .btn-custom {
        background-color: #B08E6B;
        border-color: #B08E6B;
        color: #FFFFFF;
        font-weight: 500;
    }

        .btn-custom:hover:not(:disabled) {
            background-color: #967656;
            border-color: #967656;
            color: #FFFFFF;
        }

    .link-custom {
        color: #8C6D4F;
        font-weight: 600;
        text-decoration: none;
    }

        .link-custom:hover {
            color: #6B5036;
            text-decoration: underline;
        }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4">Entrar</h3>

                    @if (TempData["Sucesso"] != null)
                    {
                        <div class="alert alert-success small" role="alert">
                            @TempData["Sucesso"]
                        </div>
                    }

                    <form asp-controller="Auth" asp-action="Login" method="post" id="formLogin">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- E-mail ou Nome de Usuário -->
                        <div class="mb-3">
                            <label asp-for="EmailOuUsuario" class="form-label">E-mail ou Nome de Usuário</label>
                            <input asp-for="EmailOuUsuario" class="form-control" placeholder="seu@email.com ou joaosilva" required />
                            <span asp-validation-for="EmailOuUsuario" class="text-danger small"></span>
                        </div>

                        <!-- Senha -->
                        <div class="mb-3">
                            <label asp-for="Senha" class="form-label">Senha</label>
                            <div class="input-group">
                                <input asp-for="Senha" type="password" class="form-control" id="inputSenhaLogin" placeholder="Digite sua senha" required />
                                <button class="btn btn-toggle-custom" type="button" id="btnToggleSenha">
                                    Mostrar
                                </button>
                            </div>
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>

                        <!-- Lembrar-me -->
                        <div class="mb-3 form-check">
                            <input asp-for="LembrarMe" class="form-check-input" />
                            <label asp-for="LembrarMe" class="form-check-label small">Manter conectado</label>
                        </div>

                        <!-- Botão Entrar -->
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-custom">
                                Entrar
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <small>Ainda não tem uma conta? <a asp-controller="Auth" asp-action="Cadastro" class="link-custom">Cadastre-se</a></small>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const inputSenha = document.getElementById("inputSenhaLogin");
            const btnToggle = document.getElementById("btnToggleSenha");

            btnToggle.addEventListener("click", function() {
                const isPassword = inputSenha.type === "password";
                inputSenha.type = isPassword ? "text" : "password";
                btnToggle.textContent = isPassword ? "Ocultar" : "Mostrar";
            });
        });
    </script>
}
