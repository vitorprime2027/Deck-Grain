@model IEnumerable<DeckGrain.Models.Comentario>

<h1>Lista de Comentários</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Comentário</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Conteúdo</th>
            <th>Post</th>
            <th>Autor (Perfil)</th>
            <th>Data</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Conteudo</td>
                <td>@item.Post?.Titulo</td>
                <td>@item.Perfil?.Nome</td>
                <td>@item.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
