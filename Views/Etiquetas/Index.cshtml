@model IEnumerable<DeckGrain.Models.Etiqueta>
<h1>Lista de Etiquetas</h1>
<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Id</th>
            <th>Cor</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Id</td>
                <td>@item.Cor</td>
            </tr>
        }
    </tbody>
</table>