@model DeckGrain.Models.Post

<h1>Criar Novo Post</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label">Descrição</label>
        <textarea asp-for="Descricao" class="form-control" rows="3" required></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="PerfilId" class="form-label">Autor (Perfil)</label>
        <select asp-for="PerfilId" class="form-select" asp-items="ViewBag.Perfis" required>
            <option value="">-- Selecione um Perfil --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Etiquetas</label>
        <div>
            @if (ViewBag.Etiquetas != null)
            {
                foreach (var tag in ViewBag.Etiquetas)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="etiquetasSelecionadas" value="@tag.Id" id="tag_@tag.Id">
                        <label class="form-check-label" for="tag_@tag.Id">@tag.Nome</label>
                    </div>
                }
            }
        </div>
    </div>

    <button type="submit" class="btn btn-success">Salvar Post</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>
